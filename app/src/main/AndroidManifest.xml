<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.studentvotingapp">

    <!-- 🔹 Permissions must be here -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudentVotingApp">

        <!-- LAUNCHER -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- USER MODULE -->
        <activity android:name=".RegisterActivity"/>
        <activity android:name=".UserDashboardActivity"/>
        <activity android:name=".CandidateActivity"/>

        <!-- ADMIN MODULE -->
        <activity android:name=".AdminLoginActivity"/>
        <activity android:name=".AdminDashboardActivity"/>
        <activity android:name=".AdminManageCandidateActivity"/>
        <activity android:name=".AdminProfileActivity"/>
        <activity android:name=".EditAdminProfileActivity"/>
        <activity android:name=".ResultActivity"/>
        <activity android:name=".VoterManagementActivity"/>

    </application>

</manifest>